# ============================================================
# 复制本文件为 .env 并填入你的真实 Key：  cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交到 GitHub
# ============================================================

# ---------- LLM：DeepSeek（https://platform.deepseek.com 注册） ----------
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com

# 双模型路由：轻任务用 flash（便宜快），重推理用 pro
# 换模型只改这两行，代码零改动；DeepSeek 后续新模型同样即插即用
MODEL_FAST=deepseek-v4-flash
MODEL_SMART=deepseek-v4-pro

# 网络可选配置：本机代理干扰 API 访问时（SSL/超时报错），
# 在 .env 中加一行：  NO_PROXY=api.deepseek.com
# httpx 与 openai SDK 底层均识别该标准变量，对该域名绕过系统代理直连

# ---------- Embedding（第 1 阶段启用） ----------
# DeepSeek 不提供 Embedding API，向量化用 bge-m3（对话模型与 Embedding 各司其职）
# 方案一（默认，免费）：本地运行，以下留空即可
# 方案二（机器吃力时）：SiliconFlow API（https://siliconflow.cn），填入 Key 并取消注释
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Reranker（第 1 阶段启用，与 Embedding 同理：local 或 SiliconFlow）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 数据库（第 1 阶段启用） ----------
# SQLite 单文件数据库，路径相对项目根目录
DATABASE_PATH=data/awra.db

# ---------- 服务（第 3 阶段启用） ----------
# JWT 密钥（第 13 周生成：python -c "import secrets; print(secrets.token_hex(32))"）
JWT_SECRET=
JWT_EXPIRE_DAYS=7
